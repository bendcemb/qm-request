# Virtual environments
.venv/
venv/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
.env.*
!.env.example

# Uploads and User data (keep .gitkeep)
uploads/*
!uploads/.gitkeep

# Backups (keep .gitkeep)
backups/*
!backups/.gitkeep

# Logs and databases
*.log
*.sqlite3

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Backup files
*.bak
